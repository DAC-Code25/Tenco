# Exercise first installation, a later upgrade and an existing malformed file.
# Runtime credentials must survive even when a template or program is replaced.
set(_prefix "${TENCO_TEST_ROOT}/install")
set(_runtime "${_prefix}/${TENCO_INSTALL_BINDIR}/config.json")
if(IS_ABSOLUTE "${TENCO_INSTALL_BINDIR}")
    message(FATAL_ERROR "Regression test requires a relative install bindir")
endif()
file(MAKE_DIRECTORY "${_prefix}/${TENCO_INSTALL_BINDIR}")
file(REMOVE "${_runtime}")
function(install_product)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${TENCO_BUILD_DIR}" --prefix "${_prefix}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "Isolated install failed: ${_out} ${_err}")
    endif()
endfunction()
install_product()
file(SHA256 "${TENCO_SOURCE_DIR}/config.json" _template_hash)
file(SHA256 "${_runtime}" _installed_hash)
if(NOT _template_hash STREQUAL _installed_hash)
    message(FATAL_ERROR "First installation failed to seed runtime configuration")
endif()
set(_operator_config "{\n  \"schemaVersion\": 2,\n  \"network\": {\"authToken\": \"regression-only-secret\"},\n  \"futureField\": {\"value\": 42}\n}\n")
file(WRITE "${_runtime}" "${_operator_config}")
file(SHA256 "${_runtime}" _before)
install_product()
file(SHA256 "${_runtime}" _after)
if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Upgrade overwrote saved credentials or unknown configuration fields")
endif()
# Re-run the build initializer with an intentionally different template.
file(WRITE "${TENCO_TEST_ROOT}/new-template.json" "{\"network\":{\"authToken\":\"\"}}")
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DTENCO_CONFIG_TEMPLATE=${TENCO_TEST_ROOT}/new-template.json"
    "-DTENCO_RUNTIME_CONFIG=${_runtime}"
    -P "${TENCO_SOURCE_DIR}/cmake/initialize_runtime_config.cmake" RESULT_VARIABLE _rc)
file(SHA256 "${_runtime}" _after)
if(NOT _rc EQUAL 0 OR NOT _before STREQUAL _after)
    message(FATAL_ERROR "Build initialization changed an existing runtime configuration")
endif()
file(WRITE "${_runtime}" "operator-file-needing-repair\n")
file(SHA256 "${_runtime}" _before)
install_product()
file(SHA256 "${_runtime}" _after)
if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Install replaced an existing unreadable operator configuration")
endif()
message(STATUS "First install seeded defaults; upgrade and build preserved runtime bytes")
